# Copiar a .env.local y rellenar. Nunca subir .env* con valores reales.

# --- Modo de datos ---------------------------------------------------------
# mock: sin Firebase (login simulado, datos en memoria). Solo desarrollo.
# firebase: Firestore + Firebase Auth reales. Obligatorio en producción.
VITE_DATA_MODE=mock
DATA_MODE=mock

# --- Cliente (expuestas en el bundle: solo valores públicos) ----------------
# true: la portada muestra «Sitio en construcción» (en Vercel, solo en Production).
VITE_UNDER_CONSTRUCTION=false
# Acceso anticipado con la web en construcción: /?acceso=CLAVE. Aquí va la huella, no la clave:
# printf '%s' 'CLAVE' | shasum -a 256
VITE_PREVIEW_KEY_HASH=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# App Check: clave de sitio de reCAPTCHA Enterprise (pública). Vacía: no se envía comprobante.
VITE_RECAPTCHA_SITE_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=
VITE_IMAGEKIT_PUBLIC_KEY=

# --- Servidor (solo funciones de /api; configurar en Vercel) ---------------
# false: inscripciones cerradas al público (administración sí puede). Vacía: abiertas.
REGISTRATION_OPEN=
# App Check en /api/registration: off | monitor (solo registra) | enforce (exige).
APP_CHECK=off
# JSON completo de la cuenta de servicio de Firebase, en una sola línea.
FIREBASE_SERVICE_ACCOUNT=

# Correo: console (desarrollo) | gmail | resend
MAIL_PROVIDER=console
MAIL_FROM="V Congreso de Museos de Canarias <tu-cuenta@gmail.com>"
# Gmail: contraseña de aplicación (Cuenta de Google → Seguridad → Contraseñas de aplicaciones)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Resend: solo con dominio propio verificado (no admite remitentes @gmail.com)
RESEND_API_KEY=
# Aviso a la organización de cada inscripción (opcional)
ORGANIZER_EMAIL=

IMAGEKIT_PRIVATE_KEY=
