rules_version = '2';

// Las inscripciones solo se escriben desde el servidor (/api con firebase-admin,
// que ignora estas reglas). Desde el navegador: nadie escribe; cada persona
// solo lee lo suyo; administración (custom claim admin) lee todo.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if false;
    }

    match /registrations/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;

      match /private/{doc} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
