# Desarrollo contra los emuladores de Firebase (npm run emulators + npm run dev:emulators).
# Solo valores de prueba: el proyecto «demo-…» nunca toca servicios reales.

# Navegador
VITE_DATA_MODE=firebase
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-congreso
VITE_FIREBASE_APP_ID=demo-app
VITE_RECAPTCHA_SITE_KEY=
VITE_UNDER_CONSTRUCTION=false

# Servidor (/api en vite dev)
DATA_MODE=firebase
GCLOUD_PROJECT=demo-congreso
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
APP_CHECK=off
REGISTRATION_OPEN=true
MAIL_PROVIDER=console
